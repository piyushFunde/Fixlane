# Copy this file to .env and fill in real values. Never commit .env to version control.

POSTGRES_DB=fixlane
POSTGRES_USER=fixlane
POSTGRES_PASSWORD=change_me_strong_password

# Generate with: openssl rand -base64 32
JWT_SECRET=change_me_at_least_32_chars_random_secret

CORS_ORIGIN=http://localhost:5173

# Default password assigned to invited users — must be changed on first login
INVITED_DEFAULT_PASSWORD=change_me_invited_default
